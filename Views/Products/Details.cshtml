@model Product

@{
    ViewData["Title"] = "Produktdetails";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="mb-4">
            <h1 class="fw-bold mb-1">Produktdetails</h1>
            <p class="text-muted mb-0">
                Lesen Sie die Informationen zu diesem Produkt.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="mb-4">
                    <span class="text-muted small">ID</span>
                    <p class="mb-0">#@Model.Id</p>
                </div>

                <div class="mb-4">
                    <span class="text-muted small">Produktname</span>
                    <h2 class="h4 fw-bold mb-0">@Model.Name</h2>
                </div>

                <div class="mb-4">
                    <span class="text-muted small">Beschreibung</span>
                    <p class="mb-0">@Model.Description</p>
                </div>

                <div class="mb-4">
                    <span class="text-muted small">Preis</span>
                    <p class="fs-3 fw-bold mb-0">
                        @Model.Price.ToString(
                            "C2",
                            System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
                    </p>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Zurück zum Katalog
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Bearbeiten
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
