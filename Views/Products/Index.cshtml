@model IReadOnlyList<Product>

@{
    ViewData["Title"] = "Katalog der Produkte";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Katalog der Produkte</h1>
        <p class="text-muted mb-0">
            Finden Sie alle Ihre Produkte an einem Ort.
        </p>
    </div>

    
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-primary">
            + Produkt erstellen
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Produkte im Katalog</span>
            <span class="badge rounded-pill text-bg-primary">
                @Model.Count
            </span>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state text-center p-5">
        <h2 class="h4 mb-2">Keine Produkte vorhanden</h2>
        <p class="text-muted mb-4">
            Beginnen Sie damit, Ihr erstes Produkt zum Katalog hinzuzufügen.
        </p>
        <a asp-action="Create" class="btn btn-primary">
            Meinen ersten Produkt erstellen
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card product-card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@product.Name</h5>

                        <p class="card-text text-muted">
                            @product.Description
                        </p>

                        <p class="product-price mt-auto">
                            @product.Price.ToString(
                                "C2",
                                System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))
                        </p>

                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-secondary btn-sm">
                                Bearbeiten
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-danger btn-sm">
                                Löschen
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}